# Copy to .env (repo root) and fill in. Never commit .env.

# --- Login sessions (any long random string; generate one with:
#     python -c "import secrets; print(secrets.token_hex(32))") ---
SECRET_KEY=

# --- Outlook email import (Microsoft Entra app registration) ---
CLIENT_ID=
TENANT_ID=common
CLIENT_SECRET=            # unused (public client); leave blank

# --- Event extraction via OpenRouter (create your own free key at openrouter.ai/keys) ---
OPENAI_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# --- Shared Google Calendar (public; events are written by a service account) ---
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=EventFlow-calendar-key.json   # key file in the repo root (gitignored)

# --- Firebase Realtime Database (Project settings -> Your apps -> Web app config) ---
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
